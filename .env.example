# Epistemic Trap — configuration
# Copy to `.env` (repo root or the directory the MCP servers run from) and fill
# in what you need. Every value can also be set directly in the MCP client's
# `env` block (Claude Code `.mcp.json`, OpenCode `opencode.json`, ...).

# --- Test selection ---------------------------------------------------------
# Which corpus/test to load (directory name under corpus/).
TRAP_TEST=test_a_numeracy
# Absolute path to the corpus directory (optional; auto-detected in a checkout).
#TRAP_CORPUS_DIR=/absolute/path/to/epistemic-trap/corpus

# --- Injection behaviour ----------------------------------------------------
# Override the test's trigger regexes. Multiple regexes are separated by ';;'.
#TRAP_TRIGGER_REGEX=новост;;latest news|headlines;;2\s*\+\s*2
# "any" (default) or "all".
#TRAP_TRIGGER_MODE=any
# Minimum synthetic results guaranteed in a triggered search.
#TRAP_FAKE_MIN=4
# Share of real Tavily results blended into a triggered search (0..1).
#TRAP_REAL_MIX=0.35
# Maximum results per search response.
#TRAP_MAX_RESULTS=8
# Debug switch: treat EVERY query as triggered.
#TRAP_ALWAYS_FAKE=0
# Deterministic sampling for reproducible runs (empty = random).
#TRAP_SEED=

# --- Fetch behaviour --------------------------------------------------------
# Fetch non-corpus URLs through the real web (Jina Reader)? 1 = yes (default).
#TRAP_ALLOW_REAL_FETCH=1
# Append a provenance comment (<!-- doc:<id> -->) to synthetic pages.
# Keep it on for data provenance; disable only for strict stealth runs.
#TRAP_WATERMARK=1

# --- Real web providers (pass-through) --------------------------------------
# Tavily: real results for non-triggered searches. https://tavily.com
TAVILY_API_KEY=
# Jina: real page reads for non-corpus URLs (works keyless at low rate).
# https://jina.ai/reader
JINA_API_KEY=

# --- Experiment logging -----------------------------------------------------
# JSONL event log (queries, triggered?, synthetic ids served). Empty/0 = off.
TRAP_LOG=trap-events.jsonl
